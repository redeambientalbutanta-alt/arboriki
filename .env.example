# Copie para `.env` e ajuste. Carregue com:  uv run --env-file .env arboriki extract

# Caminho do executável do Tesseract. Só é preciso se `tesseract` NÃO estiver no PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Idioma(s) do OCR. Padrão: por. Combine com "+", ex.: por+eng
# ARBORIKI_OCR_LANG=por

# Pasta que contém `tessdata/`. Só é preciso se os `.traineddata` ficarem fora da instalação padrão.
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR
